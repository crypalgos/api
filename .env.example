# Environment configuration
ENV=development
DEBUG=True

#database config
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/crypalgos

#jwt config
REFRESH_TOKEN_SECRET_KEY=
ACCESS_TOKEN_SECRET_KEY=
JWT_ALGORITHMS=HS256
REFRESH_TOKEN_EXPIRE_MINUTES=
ACCESS_TOKEN_EXPIRE_MINUTES=


#resend config
RESEND_API_TOKEN=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Crypalgos Team

#google config
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Waitlist config / Sandbox config
WAITLIST=true
SANDBOX_ENABLED=false
WORKSPACE_ROOT=/var/lib/docker/volumes/ubuntu_jenkins_home/_data/workspace/crypalgos_api

# Clickhouse config
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASS=

# Celery / Redis config
REDIS_URL=redis://localhost:6379/0

# Dedicated streamer-service PUB endpoint. Production should use the private
# service address (for example tcp://streamer-service:5555), not localhost.
STREAMER_ZMQ_ADDRESS=tcp://127.0.0.1:5555

# S3 configuration
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Broker credential encryption (Fernet key — generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
CREDENTIAL_ENCRYPTION_KEY=

# Telegram notification bot (optional — leave blank to disable alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=